{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReachPanel",
  "version": "0.11.1",
  "identifier": "com.nik.reach-panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReachPanel",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https://www.google.com; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; media-src 'self' asset: http://asset.localhost https://asset.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCACHE/**",
          "$PICTURE/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/wordpacks/en.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOUFGNkIwRTA3MEM4NEQKUldSTnlIRGdzUGFhc0hudnVzaGVCMFpWcUVrbkx1c3YxRnN6c3U3S3ptQ3hSZUVSOVRlOGJGQ0sK",
      "endpoints": [
        "https://raw.githubusercontent.com/pountzas/reach-Panel/main/updater/latest.json",
        "https://github.com/pountzas/reach-Panel/releases/latest/download/latest.json"
      ]
    }
  }
}
