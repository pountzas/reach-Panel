{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accessibility Keyboard",
  "version": "0.5.0",
  "identifier": "com.nik.accessibility-keyboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Accessibility Keyboard",
        "width": 1200,
        "height": 700,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwOUFGNkIwRTA3MEM4NEQKUldSTnlIRGdzUGFhc0hudnVzaGVCMFpWcUVrbkx1c3YxRnN6c3U3S3ptQ3hSZUVSOVRlOGJGQ0sK",
      "endpoints": [
        "https://github.com/pountzas/accessibility-keyboard/releases/latest/download/latest.json"
      ]
    }
  }
}
